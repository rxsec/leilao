generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  customer
}

enum LotType {
  property
  electronics
  luxury
  other
}

enum LotStatus {
  draft
  scheduled
  live
  closed
}

enum OrderStatus {
  pending
  paid
  cancelled
}

enum PasswordResetStatus {
  pending
  resolved
}

model AppUser {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  birthDate        DateTime? @map("birth_date") @db.Date
  email            String    @unique
  cpf              String?   @unique
  cep              String?
  street           String?
  streetNumber     String?   @map("street_number")
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  whatsapp         String?
  passwordHash     String    @map("password_hash")
  role             UserRole  @default(customer)
  registrationSlug String?   @unique @map("registration_slug")
  managedByAdminId String?   @map("managed_by_admin_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  bids             Bid[]
  orders           Order[]
  wonLots          Lot[]     @relation("LotWinner")
  managerAdmin     AppUser?  @relation("AdminCustomers", fields: [managedByAdminId], references: [id], onDelete: SetNull)
  managedCustomers AppUser[] @relation("AdminCustomers")

  @@map("app_users")
}

model PasswordResetRequest {
  id         String              @id @default(uuid()) @db.Uuid
  email      String
  note       String?
  status     PasswordResetStatus @default(pending)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?           @map("resolved_at") @db.Timestamptz(6)

  @@map("password_reset_requests")
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String    @unique
  activeLots Int       @default(0) @map("active_lots")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lots       Lot[]

  @@map("categories")
}

model Lot {
  id            String    @id @default(uuid()) @db.Uuid
  categoryId    String?   @map("category_id") @db.Uuid
  title         String
  slug          String    @unique
  description   String?
  type          LotType
  status        LotStatus @default(live)
  city          String?
  state         String?
  currentBid    Decimal   @default(0) @map("current_bid") @db.Decimal(12, 2)
  bidCount      Int       @default(0) @map("bid_count")
  minIncrement  Decimal   @default(100) @map("min_increment") @db.Decimal(12, 2)
  reservePrice  Decimal?  @map("reserve_price") @db.Decimal(12, 2)
  buyNowPrice   Decimal?  @map("buy_now_price") @db.Decimal(12, 2)
  imageUrl      String?   @map("image_url")
  isFeatured    Boolean   @default(false) @map("is_featured")
  endsAt        DateTime? @map("ends_at") @db.Timestamptz(6)
  winnerUserId  String?   @map("winner_user_id") @db.Uuid
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bids          Bid[]
  images        LotImage[]
  orders        Order[]
  winnerUser    AppUser?  @relation("LotWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)

  @@map("lots")
}

model LotImage {
  id        String   @id @default(uuid()) @db.Uuid
  lotId     String   @map("lot_id") @db.Uuid
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lot       Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@map("lot_images")
}

model Bid {
  id         String   @id @default(uuid()) @db.Uuid
  lotId      String   @map("lot_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  bidderName String   @map("bidder_name")
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lot        Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  user       AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("bids")
}

model NewsletterSubscriber {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("newsletter_subscribers")
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  lotId     String      @unique @map("lot_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  amount    Decimal     @db.Decimal(12, 2)
  status    OrderStatus @default(pending)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt    DateTime?   @map("paid_at") @db.Timestamptz(6)
  lot       Lot         @relation(fields: [lotId], references: [id], onDelete: Cascade)
  user      AppUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
}
